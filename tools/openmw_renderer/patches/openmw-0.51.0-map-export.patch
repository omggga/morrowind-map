+    int parseInteger(std::string_view value, std::string_view label)
+    {
+        int result = 0;
+        const auto [end, error] = std::from_chars(value.data(), value.data() + value.size(), result);
+        if (error != std::errc{} || end != value.data() + value.size())
+            throw std::runtime_error("Invalid " + std::string(label) + ": " + std::string(value));
+        return result;
+    }
+
+    const std::optional<LocalMapExportConfig>& getLocalMapExportConfig()
+    {
+        static const std::optional<LocalMapExportConfig> config = []() -> std::optional<LocalMapExportConfig> {
+            const char* cellValue = std::getenv("MWMAP_EXPORT_CELL");
+            const char* outputValue = std::getenv("MWMAP_EXPORT_PATH");
+            if (cellValue == nullptr && outputValue == nullptr)
+                return std::nullopt;
+            if (cellValue == nullptr || outputValue == nullptr)
+                throw std::runtime_error("MWMAP_EXPORT_CELL and MWMAP_EXPORT_PATH must be set together");
+
+            const std::string_view cell(cellValue);
+            const std::size_t comma = cell.find(',');
+            if (comma == std::string_view::npos || cell.find(',', comma + 1) != std::string_view::npos)
+                throw std::runtime_error("MWMAP_EXPORT_CELL must use the exact x,y form");
+
+            int gutterPixels = 16;
+            if (const char* gutterValue = std::getenv("MWMAP_EXPORT_GUTTER_PIXELS"))
+                gutterPixels = parseInteger(gutterValue, "MWMAP_EXPORT_GUTTER_PIXELS");
+            if (gutterPixels < 0 || gutterPixels > 128)
+                throw std::runtime_error("MWMAP_EXPORT_GUTTER_PIXELS must be between 0 and 128");
+
+            std::filesystem::path outputPath(outputValue);
+            if (!outputPath.is_absolute())
+                throw std::runtime_error("MWMAP_EXPORT_PATH must be absolute");
+
+            return LocalMapExportConfig{ parseInteger(cell.substr(0, comma), "MWMAP_EXPORT_CELL x"),
+                parseInteger(cell.substr(comma + 1), "MWMAP_EXPORT_CELL y"), gutterPixels,
+                std::move(outputPath) };
+        }();
+        return config;
+    }
