     void CameraLocalUpdateCallback::operator()(LocalMapRenderToTexture* node, osg::NodeVisitor* nv)
     {
+        if (!node->mExportPath.empty())
+        {
+            if (node->mExportFramesSeen > 0)
+            {
+                bool written = false;
+                try
+                {
+                    std::filesystem::create_directories(node->mExportPath.parent_path());
+                    osg::ref_ptr<osg::Image> output
+                        = new osg::Image(*node->mExportImage, osg::CopyOp::DEEP_COPY_ALL);
+                    output->flipVertical();
+                    const std::filesystem::path temporary
+                        = node->mExportPath.parent_path() / (node->mExportPath.filename().string() + ".tmp.png");
+                    if (osgDB::writeImageFile(*output, temporary.string()))
+                    {
+                        std::error_code error;
+                        std::filesystem::rename(temporary, node->mExportPath, error);
+                        if (!error)
+                            written = true;
+                        else
+                            Log(Debug::Error) << "MWMAP failed to publish " << node->mExportPath << ": "
+                                              << error.message();
+                    }
+                }
+                catch (const std::exception& error)
+                {
+                    Log(Debug::Error) << "MWMAP export failed: " << error.what();
+                }
+
+                if (written)
+                    Log(Debug::Info) << "MWMAP export complete: " << node->mExportPath;
+                else
+                    Log(Debug::Error) << "MWMAP export produced no output: " << node->mExportPath;
+
+                node->setNodeMask(0);
+                node->mActive = false;
+                MWBase::Environment::get().getStateManager()->requestQuit();
+                return;
+            }
+
+            ++node->mExportFramesSeen;
+            traverse(node, nv);
+            return;
+        }
+
         if (!node->mActive)
             node->setNodeMask(0);
 
