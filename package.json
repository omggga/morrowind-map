{
  "name": "morrowind-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @morrowind-map/web dev",
    "data:renderer-spike": "python3 -m tools.land_renderer.spike",
    "data:openmw-spike": "python3 -m tools.openmw_renderer.spike",
    "data:openmw-smoke": "python3 -m tools.openmw_renderer.spike --skip-build --smoke-only",
    "data:original:plan": "python3 -m tools.original_renderer.production plan --output-plan local-data/openmw-production/original-goty-hd/plan.json",
    "data:original:renderer:build": "python3 -m tools.original_renderer.production build --image morrowind-map-openmw:0.51.0-original-hd-v1",
    "data:original:renderer:smoke": "pnpm data:original:renderer:smoke:balmora && pnpm data:original:renderer:smoke:vivec && pnpm data:original:renderer:smoke:ald-ruhn && pnpm data:original:renderer:smoke:seyda-neen && pnpm data:original:renderer:smoke:solstheim",
    "data:original:renderer:smoke:balmora": "python3 -m tools.original_renderer.production smoke --center=-3,-3 --output local-data/openmw-production/original-goty-hd-smoke/balmora --image morrowind-map-openmw:0.51.0-original-hd-v1 --retain-raw",
    "data:original:renderer:smoke:vivec": "python3 -m tools.original_renderer.production smoke --center=3,-12 --output local-data/openmw-production/original-goty-hd-smoke/vivec --image morrowind-map-openmw:0.51.0-original-hd-v1 --retain-raw",
    "data:original:renderer:smoke:ald-ruhn": "python3 -m tools.original_renderer.production smoke --center=-3,6 --output local-data/openmw-production/original-goty-hd-smoke/ald-ruhn --image morrowind-map-openmw:0.51.0-original-hd-v1 --retain-raw",
    "data:original:renderer:smoke:seyda-neen": "python3 -m tools.original_renderer.production smoke --center=-3,-9 --output local-data/openmw-production/original-goty-hd-smoke/seyda-neen --image morrowind-map-openmw:0.51.0-original-hd-v1 --retain-raw",
    "data:original:renderer:smoke:solstheim": "python3 -m tools.original_renderer.production smoke --center=-21,18 --output local-data/openmw-production/original-goty-hd-smoke/solstheim --image morrowind-map-openmw:0.51.0-original-hd-v1 --retain-raw",
    "data:original:renderer:render": "python3 -m tools.original_renderer.production render --output local-data/openmw-production/original-goty-hd --image morrowind-map-openmw:0.51.0-original-hd-v1 --workers 2",
    "data:original:renderer:finalize": "python3 -m tools.original_renderer.production finalize --output local-data/openmw-production/original-goty-hd --image morrowind-map-openmw:0.51.0-original-hd-v1",
    "data:original:renderer:stabilize": "python3 -m tools.original_renderer.stabilize --source local-data/openmw-production/original-goty-hd --output local-data/openmw-release/original-goty-hd --workers 4",
    "data:original:renderer:audit": "python3 -m tools.original_renderer.audit full --output local-data/openmw-release/original-goty-hd --image morrowind-map-openmw:0.51.0-original-hd-v1 --workers 4 --render-workers 2",
    "data:original:dataset:validate": "python3 -m tools.original_renderer.publish --source-root local-data/openmw-release/original-goty-hd validate --require-quality",
    "data:original:dataset:prepare": "python3 -m tools.original_renderer.publish --source-root local-data/openmw-release/original-goty-hd prepare",
    "data:original:catalog:build": "python3 -m tools.catalog_pipeline.original build",
    "data:original:catalog:validate": "python3 -m tools.catalog_pipeline.original validate",
    "data:original:catalog:prepare": "python3 -m tools.catalog_pipeline.original prepare",
    "data:poison:plan": "pnpm data:poison:v4:plan",
    "data:poison:renderer:build": "pnpm data:poison:v4:renderer:build",
    "data:poison:renderer:smoke": "pnpm data:poison:v4:renderer:smoke",
    "data:poison:renderer:benchmark": "pnpm data:poison:v4:renderer:benchmark",
    "data:poison:renderer:render": "pnpm data:poison:v4:renderer:render",
    "data:poison:renderer:finalize": "pnpm data:poison:v4:renderer:finalize",
    "data:poison:renderer:stabilize": "pnpm data:poison:v4:renderer:stabilize",
    "data:poison:renderer:audit": "pnpm data:poison:v4:renderer:audit",
    "data:poison:dataset:validate": "pnpm data:poison:v4:dataset:validate",
    "data:poison:dataset:prepare": "pnpm data:poison:v4:dataset:prepare",
    "data:poison:v1:dataset:validate": "python3 -m tools.openmw_renderer.publish validate --require-quality",
    "data:poison:v4:plan": "python3 -m tools.openmw_renderer.production plan --output-plan local-data/openmw-production/poison-song-26.08-v4/plan.json",
    "data:poison:v4:renderer:build": "python3 -m tools.openmw_renderer.production build --image morrowind-map-openmw:0.51.0-stage5-v4",
    "data:poison:v4:renderer:smoke": "python3 -m tools.openmw_renderer.production smoke --center 3,-12 --output local-data/openmw-production/poison-song-26.08-v4-vivec-smoke-final --image morrowind-map-openmw:0.51.0-stage5-v4 --retain-raw && pnpm data:poison:v4:renderer:preview",
    "data:poison:v4:renderer:preview": "bash tools/openmw_renderer/vivec-preview.sh",
    "data:poison:v4:renderer:benchmark": "python3 -m tools.openmw_renderer.benchmark --output local-data/openmw-production/poison-song-26.08-v4/benchmark/five-controls-workers2-method4 --image morrowind-map-openmw:0.51.0-stage5-v4 --workers 2",
    "data:poison:v4:renderer:render": "python3 -m tools.openmw_renderer.production render --output local-data/openmw-production/poison-song-26.08-v4 --image morrowind-map-openmw:0.51.0-stage5-v4 --workers 2",
    "data:poison:v4:renderer:finalize": "python3 -m tools.openmw_renderer.production finalize --output local-data/openmw-production/poison-song-26.08-v4 --image morrowind-map-openmw:0.51.0-stage5-v4",
    "data:poison:v4:renderer:stabilize": "python3 -m tools.openmw_renderer.stabilize --source local-data/openmw-production/poison-song-26.08-v4 --output local-data/openmw-release/poison-song-26.08-v4 --workers 4",
    "data:poison:v4:renderer:audit": "python3 -m tools.openmw_renderer.audit full --output local-data/openmw-release/poison-song-26.08-v4 --image morrowind-map-openmw:0.51.0-stage5-v4 --workers 4 --render-workers 2",
    "data:poison:v4:dataset:validate": "python3 -m tools.openmw_renderer.publish --source-root local-data/openmw-release/poison-song-26.08-v4 validate --require-quality",
    "data:poison:v4:dataset:prepare": "python3 -m tools.openmw_renderer.publish --source-root local-data/openmw-release/poison-song-26.08-v4 prepare",
    "data:poison:catalog:build": "python3 -m tools.catalog_pipeline.poison build",
    "data:poison:catalog:validate": "python3 -m tools.catalog_pipeline.poison validate",
    "data:poison:catalog:prepare": "python3 -m tools.catalog_pipeline.poison prepare",
    "build": "pnpm --filter @morrowind-map/web build",
    "typecheck": "tsc --project tsconfig.json --pretty false && pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm test:unit && pnpm test:catalog && pnpm test:renderer && pnpm test:openmw-renderer && pnpm test:original-renderer",
    "test:unit": "vitest run",
    "test:catalog": "python3 -m unittest discover -s tools/catalog_pipeline/tests -t . -v",
    "test:renderer": "python3 -m unittest discover -s tools/land_renderer/tests -t . -v",
    "test:openmw-renderer": "python3 -m unittest discover -s tools/openmw_renderer/tests -t . -v",
    "test:original-renderer": "python3 -m unittest discover -s tools/original_renderer/tests -t . -v",
    "test:acceptance": "playwright test -c playwright.acceptance.config.ts",
    "test:acceptance:prepared": "MORROWIND_ACCEPTANCE_PREPARED=1 playwright test -c playwright.acceptance.config.ts --grep @prepared",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:acceptance && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "fake-indexeddb": "6.2.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
