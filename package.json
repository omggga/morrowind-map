{
  "name": "morrowind-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @morrowind-map/web dev",
    "data:original": "python3 -m tools.data_pipeline.build_original",
    "data:renderer-spike": "python3 -m tools.land_renderer.spike",
    "data:openmw-spike": "python3 -m tools.openmw_renderer.spike",
    "data:openmw-smoke": "python3 -m tools.openmw_renderer.spike --skip-build --smoke-only",
    "data:poison:plan": "python3 -m tools.openmw_renderer.production plan --output-plan local-data/openmw-production/poison-song-26.08/plan.json",
    "data:poison:renderer:build": "python3 -m tools.openmw_renderer.production build",
    "data:poison:renderer:smoke": "python3 -m tools.openmw_renderer.production smoke",
    "data:poison:renderer:benchmark": "python3 -m tools.openmw_renderer.benchmark --workers 2",
    "data:poison:renderer:render": "python3 -m tools.openmw_renderer.production render --workers 2",
    "data:poison:renderer:finalize": "python3 -m tools.openmw_renderer.production finalize",
    "data:poison:renderer:stabilize": "python3 -m tools.openmw_renderer.stabilize --workers 4",
    "data:poison:renderer:audit": "python3 -m tools.openmw_renderer.audit full --workers 4 --render-workers 2",
    "data:poison:dataset:validate": "python3 -m tools.openmw_renderer.publish validate --require-quality",
    "data:poison:dataset:prepare": "python3 -m tools.openmw_renderer.publish prepare",
    "build": "pnpm --filter @morrowind-map/web build",
    "typecheck": "tsc --project tsconfig.json --pretty false && pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm test:unit && pnpm test:pipeline && pnpm test:renderer && pnpm test:openmw-renderer",
    "test:unit": "vitest run",
    "test:pipeline": "python3 -m unittest discover -s tools/data_pipeline/tests -v",
    "test:renderer": "python3 -m unittest discover -s tools/land_renderer/tests -t . -v",
    "test:openmw-renderer": "python3 -m unittest discover -s tools/openmw_renderer/tests -t . -v",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "fake-indexeddb": "6.2.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
