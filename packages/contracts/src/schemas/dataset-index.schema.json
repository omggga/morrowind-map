{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrowind-map.local/schemas/dataset-index.schema.json",
  "title": "Morrowind map dataset index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultDatasetId", "datasets"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "defaultDatasetId": {
      "$ref": "#/$defs/datasetId"
    },
    "datasets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/datasetIndexEntry"
      }
    }
  },
  "$defs": {
    "datasetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "manifestUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^/datasets/[^\\s?#]+\\.json$"
    },
    "datasetIndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "manifestUrl", "order"],
      "properties": {
        "datasetId": {
          "$ref": "#/$defs/datasetId"
        },
        "manifestUrl": {
          "$ref": "#/$defs/manifestUrl"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
