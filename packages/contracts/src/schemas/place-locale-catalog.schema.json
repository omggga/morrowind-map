{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrowind-map.local/schemas/place-locale-catalog.schema.json",
  "title": "Localized Morrowind place names",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "snapshotId", "locale", "places"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetId": { "$ref": "#/$defs/identifier" },
    "snapshotId": { "$ref": "#/$defs/snapshotId" },
    "locale": { "enum": ["en", "ru"] },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["placeId", "name", "aliases"],
        "properties": {
          "placeId": { "$ref": "#/$defs/identifier" },
          "name": { "$ref": "#/$defs/text" },
          "aliases": {
            "type": "array",
            "items": { "$ref": "#/$defs/text" }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:[.:-][a-z0-9]+)*$"
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9:._-]+$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
