{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://morrowind-map.local/schemas/dataset-releases-lock.schema.json",
  "title": "Dataset release transport lock",
  "description": "Transport metadata only. Runtime tooling additionally checks identity uniqueness, canonical tag binding, contiguous part numbering, and agreement with the active dataset graph.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "tileSets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "const": "omggga/morrowind-map" },
    "tileSets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/definitions/tileSet" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "not": { "pattern": "(?:\\.lock$|[^a-z0-9.-])" }
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "tileSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "pyramidId",
        "inventorySha256",
        "format",
        "releaseTag",
        "parts"
      ],
      "properties": {
        "datasetId": { "$ref": "#/definitions/identifier" },
        "pyramidId": { "$ref": "#/definitions/identifier" },
        "inventorySha256": { "$ref": "#/definitions/sha256" },
        "format": { "const": "ustar-v1" },
        "releaseTag": {
          "type": "string",
          "minLength": 77,
          "maxLength": 331,
          "pattern": "^tiles-v1/(?=[a-z0-9.-]{1,128}/)[a-z0-9]+(?:[.-][a-z0-9]+)*/(?=[a-z0-9.-]{1,128}/)[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-f0-9]{64}$",
          "not": { "pattern": "(?:\\.lock/|[^a-z0-9./-])" }
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 999,
          "items": { "$ref": "#/definitions/part" }
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "bytes", "tileCount", "unpackedBytes"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 14,
          "maxLength": 14,
          "pattern": "^tiles-0(?:[1-9][0-9]{2}|0[1-9][0-9]|00[1-9])\\.tar$"
        },
        "sha256": { "$ref": "#/definitions/sha256" },
        "bytes": {
          "type": "integer",
          "minimum": 10240,
          "maximum": 2137483648,
          "multipleOf": 10240
        },
        "tileCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500000
        },
        "unpackedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2137483648
        }
      }
    }
  }
}
