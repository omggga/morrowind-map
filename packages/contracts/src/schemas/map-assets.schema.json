{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrowind-map.local/schemas/map-assets.schema.json",
  "title": "Morrowind map raster assets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "snapshotId", "projection", "rasters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetId": { "$ref": "#/$defs/identifier" },
    "snapshotId": { "$ref": "#/$defs/snapshotId" },
    "projection": { "const": "TES3:WORLD" },
    "rasters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/raster" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:[.:-][a-z0-9]+)*$"
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9:._-]+$"
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false
    },
    "pixelSize": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 }
      ],
      "items": false
    },
    "extent": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false
    },
    "raster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "regionId",
        "kind",
        "imageUrl",
        "mediaType",
        "pixelSize",
        "extent",
        "sha256"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "regionId": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "static-image" },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^/datasets/[^\\s?#]+\\.jpg$"
        },
        "mediaType": { "const": "image/jpeg" },
        "pixelSize": { "$ref": "#/$defs/pixelSize" },
        "extent": { "$ref": "#/$defs/extent" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
