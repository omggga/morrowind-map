# Python
.venv/
__pycache__/
.pytest_cache/
*.py[cod]

# Local render outputs stay ignored; datasets:stage adds only the validated active graph.
generated/
datasets/generated/
tiles/
renders/

# Proprietary game and mod inputs must never enter Git
*.bsa
*.ba2
*.esm
*.esp
*.omwaddon
*.omwgame
*.fnt
*.dds
*.tga
*.nif
*.kf
*.omwscripts
*.pex

